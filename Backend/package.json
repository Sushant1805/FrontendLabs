{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "executor:build": "docker build -t frontendlabs-executor:latest ./docker-executor",
    "executor:run": "docker run --rm --name frontendlabs-executor -v /tmp/execution:/tmp/execution -e NODE_OPTIONS=\"--max-old-space-size=128\" frontendlabs-executor:latest",
    "executor:run-detached": "docker run -d --name frontendlabs-executor -v /tmp/execution:/tmp/execution -e NODE_OPTIONS=\"--max-old-space-size=128\" frontendlabs-executor:latest",
    "executor:logs": "docker logs -f frontendlabs-executor",
    "executor:rm": "docker rm -f frontendlabs-executor || true"
  },
